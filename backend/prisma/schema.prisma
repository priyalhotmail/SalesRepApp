generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DELETED
}

enum OfficeType {
  MAIN
  BRANCH
}

enum WarehouseType {
  MAIN
  FACTORY_FINAL_PRODUCT
  BRANCH
}

enum SalesRepStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ProductUnitType {
  GM
  KG
  ML
  L
}

enum PriceListStatus {
  DRAFT
  ACTIVE
  SCHEDULED
  ARCHIVED
  DELETED
}

enum PriceAssignmentScope {
  GLOBAL
  CUSTOMER
  CUSTOMER_GROUP
  OFFICE
}

enum DiscountValueType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  USED
}

enum InventoryMovementType {
  STOCK_ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
  RESERVATION_CONSUME
  RETURN_RECEIPT
  TRANSFER_DISPATCH
  TRANSFER_RECEIPT
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  CANCELLED
}

enum RouteScheduleStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RESERVED
  LOADING
  DELIVERED
  CANCELLED
  AMENDMENT_PENDING
}

enum DeliveryStatus {
  PLANNED
  DISPATCHED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum SalesInvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  POSTED
  CANCELLED
}

enum ChequeStatus {
  RECEIVED
  DEPOSITED
  REALIZED
  RETURNED
  CANCELLED
}

enum SalesReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REJECTED
  CANCELLED
}

enum CommissionRunStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum WarehouseTransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  DISPATCHED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum CustomerVisitType {
  SALES
  COLLECTION
  COMPLAINT
  DELIVERY_FOLLOW_UP
}

enum CustomerVisitStatus {
  PLANNED
  COMPLETED
  MISSED
  CANCELLED
}

enum CustomerVisitOutcome {
  ORDER_PLACED
  NO_ORDER
  COLLECTION_RECEIVED
  COMPLAINT_RECORDED
  FOLLOW_UP_REQUIRED
  OTHER
}

enum AttachmentOwnerType {
  CUSTOMER
  ORDER
  DELIVERY
  SALES_INVOICE
  PAYMENT
  CHEQUE
  RETURN
  CUSTOMER_VISIT
  PRODUCT
  WAREHOUSE_TRANSFER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum SystemSettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique @db.VarChar(191)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  displayName  String     @map("display_name") @db.VarChar(160)
  telephone    String?    @db.VarChar(40)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdById  Int?       @map("created_by_id")
  updatedById  Int?       @map("updated_by_id")
  deletedAt    DateTime?  @map("deleted_at")
  deletedById  Int?       @map("deleted_by_id")

  roles                          UserRole[]
  auditLogs                      AuditLog[]                       @relation("AuditActor")
  salesReps                      SalesRep[]
  customerChangeRequests         CustomerChangeRequest[]          @relation("CustomerChangeRequestedBy")
  reviewedCustomerChangeRequests CustomerChangeRequest[]          @relation("CustomerChangeReviewedBy")
  customerChangeHistory          CustomerChangeHistory[]          @relation("CustomerHistoryChangedBy")
  requestedOrderAmendments       OrderAmendmentRequest[]          @relation("OrderAmendmentRequestedBy")
  reviewedOrderAmendments        OrderAmendmentRequest[]          @relation("OrderAmendmentReviewedBy")
  requestedCreditOverrides       CreditOverrideRequest[]          @relation("CreditOverrideRequestedBy")
  reviewedCreditOverrides        CreditOverrideRequest[]          @relation("CreditOverrideReviewedBy")
  uploadedAttachments            Attachment[]                     @relation("AttachmentUploadedBy")
  notifications                  Notification[]                   @relation("NotificationUser")
  createdNotifications           Notification[]                   @relation("NotificationCreatedBy")
  requestedWarehouseTransfers    WarehouseTransfer[]              @relation("WarehouseTransferRequestedBy")
  approvedWarehouseTransfers     WarehouseTransfer[]              @relation("WarehouseTransferApprovedBy")
  dispatchedWarehouseTransfers   WarehouseTransfer[]              @relation("WarehouseTransferDispatchedBy")
  receivedWarehouseTransfers     WarehouseTransfer[]              @relation("WarehouseTransferReceivedBy")
  warehouseTransferHistory       WarehouseTransferStatusHistory[] @relation("WarehouseTransferHistoryChangedBy")

  @@index([status])
  @@map("users")
}

model Company {
  id                    Int          @id @default(autoincrement())
  name                  String       @unique @db.VarChar(160)
  registrationNumber    String?      @map("registration_number") @db.VarChar(80)
  vatRegistrationNumber String?      @map("vat_registration_number") @db.VarChar(80)
  address               String?      @db.VarChar(500)
  email                 String?      @db.VarChar(191)
  telephone             String?      @db.VarChar(120)
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  createdById           Int?         @map("created_by_id")
  updatedById           Int?         @map("updated_by_id")
  deletedAt             DateTime?    @map("deleted_at")
  deletedById           Int?         @map("deleted_by_id")

  offices    Office[]
  factories  Factory[]
  warehouses Warehouse[]
  priceLists PriceList[]

  @@index([status])
  @@map("companies")
}

model Office {
  id            Int          @id @default(autoincrement())
  companyId     Int          @map("company_id")
  code          String       @unique @db.VarChar(40)
  name          String       @db.VarChar(160)
  officeType    OfficeType   @map("office_type")
  address       String?      @db.VarChar(500)
  email         String?      @db.VarChar(191)
  contactPerson String?      @map("contact_person") @db.VarChar(160)
  telephone     String?      @db.VarChar(120)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  createdById   Int?         @map("created_by_id")
  updatedById   Int?         @map("updated_by_id")
  deletedAt     DateTime?    @map("deleted_at")
  deletedById   Int?         @map("deleted_by_id")

  company              Company               @relation(fields: [companyId], references: [id])
  warehouses           Warehouse[]
  salesReps            SalesRep[]
  customers            Customer[]
  routes               Route[]
  orders               Order[]
  priceListAssignments PriceListAssignment[]

  @@index([companyId])
  @@index([officeType])
  @@index([status])
  @@map("offices")
}

model Factory {
  id            Int          @id @default(autoincrement())
  companyId     Int          @map("company_id")
  code          String       @unique @db.VarChar(40)
  name          String       @db.VarChar(160)
  address       String?      @db.VarChar(500)
  email         String?      @db.VarChar(191)
  contactPerson String?      @map("contact_person") @db.VarChar(160)
  telephone     String?      @db.VarChar(120)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  createdById   Int?         @map("created_by_id")
  updatedById   Int?         @map("updated_by_id")
  deletedAt     DateTime?    @map("deleted_at")
  deletedById   Int?         @map("deleted_by_id")

  company        Company                @relation(fields: [companyId], references: [id])
  warehouses     Warehouse[]
  productSources ProductFactorySource[]

  @@index([companyId])
  @@index([status])
  @@map("factories")
}

model Warehouse {
  id            Int           @id @default(autoincrement())
  companyId     Int           @map("company_id")
  officeId      Int?          @map("office_id")
  factoryId     Int?          @map("factory_id")
  code          String        @unique @db.VarChar(40)
  name          String        @db.VarChar(160)
  warehouseType WarehouseType @map("warehouse_type")
  address       String?       @db.VarChar(500)
  email         String?       @db.VarChar(191)
  contactPerson String?       @map("contact_person") @db.VarChar(160)
  telephone     String?       @db.VarChar(120)
  status        RecordStatus  @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdById   Int?          @map("created_by_id")
  updatedById   Int?          @map("updated_by_id")
  deletedAt     DateTime?     @map("deleted_at")
  deletedById   Int?          @map("deleted_by_id")

  company            Company             @relation(fields: [companyId], references: [id])
  office             Office?             @relation(fields: [officeId], references: [id])
  factory            Factory?            @relation(fields: [factoryId], references: [id])
  inventoryStocks    InventoryStock[]
  inventoryMovements InventoryMovement[]
  stockReservations  StockReservation[]
  orders             Order[]
  deliveries         Delivery[]
  outgoingTransfers  WarehouseTransfer[] @relation("TransferFromWarehouse")
  incomingTransfers  WarehouseTransfer[] @relation("TransferToWarehouse")

  @@index([companyId])
  @@index([officeId])
  @@index([factoryId])
  @@index([warehouseType])
  @@index([status])
  @@map("warehouses")
}

model SalesRep {
  id          Int            @id @default(autoincrement())
  officeId    Int            @map("office_id")
  userId      Int?           @map("user_id")
  code        String         @unique @db.VarChar(40)
  name        String         @db.VarChar(160)
  nic         String         @db.VarChar(80)
  address     String?        @db.VarChar(500)
  telephone   String?        @db.VarChar(120)
  email       String?        @db.VarChar(191)
  status      SalesRepStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  createdById Int?           @map("created_by_id")
  updatedById Int?           @map("updated_by_id")
  deletedAt   DateTime?      @map("deleted_at")
  deletedById Int?           @map("deleted_by_id")

  office          Office           @relation(fields: [officeId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  customers       Customer[]
  orders          Order[]
  salesTargets    SalesTarget[]
  commissionRules CommissionRule[]
  commissionRuns  CommissionRun[]
  customerVisits  CustomerVisit[]

  @@index([officeId])
  @@index([userId])
  @@index([status])
  @@map("sales_reps")
}

model Customer {
  id                    Int          @id @default(autoincrement())
  officeId              Int          @map("office_id")
  salesRepId            Int?         @map("sales_rep_id")
  code                  String       @unique @db.VarChar(40)
  customerType          CustomerType @map("customer_type")
  displayName           String       @map("display_name") @db.VarChar(180)
  registrationNumber    String?      @map("registration_number") @db.VarChar(80)
  vatRegistrationNumber String?      @map("vat_registration_number") @db.VarChar(80)
  nic                   String?      @db.VarChar(80)
  address               String?      @db.VarChar(500)
  telephone             String?      @db.VarChar(120)
  contactPerson         String?      @map("contact_person") @db.VarChar(160)
  email                 String?      @db.VarChar(191)
  creditLimit           Decimal      @default(0) @map("credit_limit") @db.Decimal(12, 2)
  creditHold            Boolean      @default(false) @map("credit_hold")
  creditTermsDays       Int          @default(30) @map("credit_terms_days")
  latitude              Decimal?     @db.Decimal(10, 7)
  longitude             Decimal?     @db.Decimal(10, 7)
  geoAccuracyMeters     Decimal?     @map("geo_accuracy_meters") @db.Decimal(10, 2)
  geoCapturedAt         DateTime?    @map("geo_captured_at")
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  createdById           Int?         @map("created_by_id")
  updatedById           Int?         @map("updated_by_id")
  deletedAt             DateTime?    @map("deleted_at")
  deletedById           Int?         @map("deleted_by_id")

  office                     Office                          @relation(fields: [officeId], references: [id])
  salesRep                   SalesRep?                       @relation(fields: [salesRepId], references: [id])
  changeRequests             CustomerChangeRequest[]
  history                    CustomerChangeHistory[]
  customerGroupMembers       CustomerGroupMember[]
  discountAssignments        CustomerDiscountAssignment[]
  additionalDiscountRequests AdditionalBillDiscountRequest[]
  priceListAssignments       PriceListAssignment[]
  routeAssignments           RouteCustomer[]
  orders                     Order[]
  deliveries                 Delivery[]
  salesInvoices              SalesInvoice[]
  payments                   Payment[]
  cheques                    Cheque[]
  salesReturns               SalesReturn[]
  creditOverrideRequests     CreditOverrideRequest[]
  visits                     CustomerVisit[]

  @@index([officeId])
  @@index([salesRepId])
  @@index([customerType])
  @@index([latitude, longitude])
  @@index([status])
  @@map("customers")
}

model CustomerChangeRequest {
  id               Int            @id @default(autoincrement())
  customerId       Int            @map("customer_id")
  requestedById    Int            @map("requested_by_id")
  reviewedById     Int?           @map("reviewed_by_id")
  status           ApprovalStatus @default(PENDING)
  requestedChanges Json           @map("requested_changes")
  reason           String?        @db.VarChar(500)
  reviewNote       String?        @map("review_note") @db.VarChar(500)
  createdAt        DateTime       @default(now()) @map("created_at")
  reviewedAt       DateTime?      @map("reviewed_at")

  customer    Customer @relation(fields: [customerId], references: [id])
  requestedBy User     @relation("CustomerChangeRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?    @relation("CustomerChangeReviewedBy", fields: [reviewedById], references: [id])

  @@index([customerId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
  @@map("customer_change_requests")
}

model CustomerChangeHistory {
  id              Int      @id @default(autoincrement())
  customerId      Int      @map("customer_id")
  changeRequestId Int?     @map("change_request_id")
  changedById     Int?     @map("changed_by_id")
  oldValues       Json?    @map("old_values")
  newValues       Json     @map("new_values")
  changedAt       DateTime @default(now()) @map("changed_at")

  customer  Customer @relation(fields: [customerId], references: [id])
  changedBy User?    @relation("CustomerHistoryChangedBy", fields: [changedById], references: [id])

  @@index([customerId])
  @@index([changeRequestId])
  @@index([changedById])
  @@map("customer_change_history")
}

model ProductGroup {
  id          Int          @id @default(autoincrement())
  code        String       @unique @db.VarChar(40)
  name        String       @db.VarChar(160)
  description String?      @db.VarChar(500)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  createdById Int?         @map("created_by_id")
  updatedById Int?         @map("updated_by_id")
  deletedAt   DateTime?    @map("deleted_at")
  deletedById Int?         @map("deleted_by_id")

  products Product[]

  @@index([status])
  @@map("product_groups")
}

model Product {
  id             Int             @id @default(autoincrement())
  productGroupId Int             @map("product_group_id")
  code           String          @unique @db.VarChar(40)
  name           String          @db.VarChar(180)
  price          Decimal         @db.Decimal(12, 2)
  capacity       Decimal         @db.Decimal(12, 3)
  unitType       ProductUnitType @map("unit_type")
  supportsBulk   Boolean         @default(false) @map("supports_bulk")
  status         RecordStatus    @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdById    Int?            @map("created_by_id")
  updatedById    Int?            @map("updated_by_id")
  deletedAt      DateTime?       @map("deleted_at")
  deletedById    Int?            @map("deleted_by_id")

  productGroup           ProductGroup             @relation(fields: [productGroupId], references: [id])
  packagingOptions       ProductPackagingOption[]
  factorySources         ProductFactorySource[]
  priceListItems         PriceListItem[]
  priceHistory           ProductPriceHistory[]
  seasonalDiscounts      SeasonalDiscount[]
  freeItemOffers         FreeItemOffer[]
  inventoryStocks        InventoryStock[]
  inventoryMovements     InventoryMovement[]
  stockReservations      StockReservation[]
  orderItems             OrderItem[]
  deliveryItems          DeliveryItem[]
  salesInvoiceItems      SalesInvoiceItem[]
  salesReturnItems       SalesReturnItem[]
  salesTargets           SalesTarget[]
  commissionRules        CommissionRule[]
  warehouseTransferItems WarehouseTransferItem[]

  @@index([productGroupId])
  @@index([status])
  @@map("products")
}

model ProductPackagingOption {
  id           Int          @id @default(autoincrement())
  productId    Int          @map("product_id")
  name         String       @db.VarChar(120)
  unitQuantity Int          @map("unit_quantity")
  isDefault    Boolean      @default(false) @map("is_default")
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@unique([productId, name])
  @@index([productId])
  @@index([status])
  @@map("product_packaging_options")
}

model ProductFactorySource {
  productId  Int      @map("product_id")
  factoryId  Int      @map("factory_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  product Product @relation(fields: [productId], references: [id])
  factory Factory @relation(fields: [factoryId], references: [id])

  @@id([productId, factoryId])
  @@index([factoryId])
  @@map("product_factory_sources")
}

model CustomerGroup {
  id          Int          @id @default(autoincrement())
  code        String       @unique @db.VarChar(40)
  name        String       @db.VarChar(160)
  description String?      @db.VarChar(500)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  createdById Int?         @map("created_by_id")
  updatedById Int?         @map("updated_by_id")
  deletedAt   DateTime?    @map("deleted_at")
  deletedById Int?         @map("deleted_by_id")

  members              CustomerGroupMember[]
  priceListAssignments PriceListAssignment[]

  @@index([status])
  @@map("customer_groups")
}

model CustomerGroupMember {
  customerGroupId Int      @map("customer_group_id")
  customerId      Int      @map("customer_id")
  assignedAt      DateTime @default(now()) @map("assigned_at")
  assignedById    Int?     @map("assigned_by_id")

  customerGroup CustomerGroup @relation(fields: [customerGroupId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])

  @@id([customerGroupId, customerId])
  @@index([customerId])
  @@map("customer_group_members")
}

model PriceList {
  id            Int             @id @default(autoincrement())
  companyId     Int             @map("company_id")
  code          String          @unique @db.VarChar(40)
  name          String          @db.VarChar(160)
  effectiveFrom DateTime        @map("effective_from")
  effectiveTo   DateTime?       @map("effective_to")
  status        PriceListStatus @default(DRAFT)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  createdById   Int?            @map("created_by_id")
  updatedById   Int?            @map("updated_by_id")
  deletedAt     DateTime?       @map("deleted_at")
  deletedById   Int?            @map("deleted_by_id")

  company     Company               @relation(fields: [companyId], references: [id])
  items       PriceListItem[]
  assignments PriceListAssignment[]

  @@index([companyId])
  @@index([status])
  @@index([effectiveFrom])
  @@map("price_lists")
}

model PriceListItem {
  id          Int      @id @default(autoincrement())
  priceListId Int      @map("price_list_id")
  productId   Int      @map("product_id")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  priceList PriceList @relation(fields: [priceListId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([priceListId, productId])
  @@index([productId])
  @@map("price_list_items")
}

model PriceListAssignment {
  id              Int                  @id @default(autoincrement())
  priceListId     Int                  @map("price_list_id")
  scope           PriceAssignmentScope
  customerId      Int?                 @map("customer_id")
  customerGroupId Int?                 @map("customer_group_id")
  officeId        Int?                 @map("office_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  createdById     Int?                 @map("created_by_id")

  priceList     PriceList      @relation(fields: [priceListId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  customerGroup CustomerGroup? @relation(fields: [customerGroupId], references: [id])
  office        Office?        @relation(fields: [officeId], references: [id])

  @@index([priceListId])
  @@index([scope])
  @@index([customerId])
  @@index([customerGroupId])
  @@index([officeId])
  @@map("price_list_assignments")
}

model ProductPriceHistory {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  priceListId Int?     @map("price_list_id")
  oldPrice    Decimal? @map("old_price") @db.Decimal(12, 2)
  newPrice    Decimal  @map("new_price") @db.Decimal(12, 2)
  changedAt   DateTime @default(now()) @map("changed_at")
  changedById Int?     @map("changed_by_id")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([priceListId])
  @@index([changedAt])
  @@map("product_price_history")
}

model DiscountClass {
  id                 Int          @id @default(autoincrement())
  code               String       @unique @db.VarChar(40)
  name               String       @db.VarChar(160)
  discountPercentage Decimal      @map("discount_percentage") @db.Decimal(5, 2)
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  createdById        Int?         @map("created_by_id")
  updatedById        Int?         @map("updated_by_id")
  deletedAt          DateTime?    @map("deleted_at")
  deletedById        Int?         @map("deleted_by_id")

  customerAssignments CustomerDiscountAssignment[]

  @@index([status])
  @@map("discount_classes")
}

model CustomerDiscountAssignment {
  id              Int       @id @default(autoincrement())
  customerId      Int       @map("customer_id")
  discountClassId Int       @map("discount_class_id")
  effectiveFrom   DateTime  @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdById     Int?      @map("created_by_id")

  customer      Customer      @relation(fields: [customerId], references: [id])
  discountClass DiscountClass @relation(fields: [discountClassId], references: [id])

  @@index([customerId])
  @@index([discountClassId])
  @@index([effectiveFrom])
  @@map("customer_discount_assignments")
}

model SeasonalDiscount {
