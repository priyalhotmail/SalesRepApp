model CommissionRun {
  id               Int                 @id @default(autoincrement())
  salesRepId       Int                 @map("sales_rep_id")
  periodYear       Int                 @map("period_year")
  periodMonth      Int                 @map("period_month")
  revenueAmount    Decimal             @default(0) @map("revenue_amount") @db.Decimal(12, 2)
  volumeAmount     Decimal             @default(0) @map("volume_amount") @db.Decimal(12, 3)
  commissionAmount Decimal             @default(0) @map("commission_amount") @db.Decimal(12, 2)
  bonusAmount      Decimal             @default(0) @map("bonus_amount") @db.Decimal(12, 2)
  totalAmount      Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  status           CommissionRunStatus @default(DRAFT)
  calculatedAt     DateTime            @default(now()) @map("calculated_at")
  approvedAt       DateTime?           @map("approved_at")
  paidAt           DateTime?           @map("paid_at")
  createdById      Int?                @map("created_by_id")
  approvedById     Int?                @map("approved_by_id")

  salesRep SalesRep @relation(fields: [salesRepId], references: [id])

  @@unique([salesRepId, periodYear, periodMonth])
  @@index([status])
  @@map("commission_runs")
}

model WarehouseTransfer {
  id              Int                     @id @default(autoincrement())
  transferNumber  String                  @unique @map("transfer_number") @db.VarChar(40)
  fromWarehouseId Int                     @map("from_warehouse_id")
  toWarehouseId   Int                     @map("to_warehouse_id")
  status          WarehouseTransferStatus @default(REQUESTED)
  notes           String?                 @db.VarChar(500)
  requestedById   Int                     @map("requested_by_id")
  approvedById    Int?                    @map("approved_by_id")
  dispatchedById  Int?                    @map("dispatched_by_id")
  receivedById    Int?                    @map("received_by_id")
  requestedAt     DateTime                @default(now()) @map("requested_at")
  approvedAt      DateTime?               @map("approved_at")
  dispatchedAt    DateTime?               @map("dispatched_at")
  receivedAt      DateTime?               @map("received_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  fromWarehouse Warehouse                        @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse                        @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  requestedBy   User                             @relation("WarehouseTransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy    User?                            @relation("WarehouseTransferApprovedBy", fields: [approvedById], references: [id])
  dispatchedBy  User?                            @relation("WarehouseTransferDispatchedBy", fields: [dispatchedById], references: [id])
  receivedBy    User?                            @relation("WarehouseTransferReceivedBy", fields: [receivedById], references: [id])
  items         WarehouseTransferItem[]
  history       WarehouseTransferStatusHistory[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@index([requestedAt])
  @@map("warehouse_transfers")
}

model WarehouseTransferItem {
  id                  Int     @id @default(autoincrement())
  warehouseTransferId Int     @map("warehouse_transfer_id")
  productId           Int     @map("product_id")
  requestedQuantity   Decimal @map("requested_quantity") @db.Decimal(12, 3)
  approvedQuantity    Decimal @default(0) @map("approved_quantity") @db.Decimal(12, 3)
  dispatchedQuantity  Decimal @default(0) @map("dispatched_quantity") @db.Decimal(12, 3)
  receivedQuantity    Decimal @default(0) @map("received_quantity") @db.Decimal(12, 3)
  notes               String? @db.VarChar(500)

  warehouseTransfer WarehouseTransfer @relation(fields: [warehouseTransferId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])

  @@unique([warehouseTransferId, productId])
  @@index([productId])
  @@map("warehouse_transfer_items")
}

model WarehouseTransferStatusHistory {
  id                  Int                      @id @default(autoincrement())
  warehouseTransferId Int                      @map("warehouse_transfer_id")
  oldStatus           WarehouseTransferStatus? @map("old_status")
  newStatus           WarehouseTransferStatus  @map("new_status")
  notes               String?                  @db.VarChar(500)
  changedById         Int?                     @map("changed_by_id")
  changedAt           DateTime                 @default(now()) @map("changed_at")

  warehouseTransfer WarehouseTransfer @relation(fields: [warehouseTransferId], references: [id])
  changedBy         User?             @relation("WarehouseTransferHistoryChangedBy", fields: [changedById], references: [id])

  @@index([warehouseTransferId])
  @@index([changedById])
  @@index([changedAt])
  @@map("warehouse_transfer_status_history")
}

model CustomerVisit {
  id                Int                   @id @default(autoincrement())
  customerId        Int                   @map("customer_id")
  salesRepId        Int?                  @map("sales_rep_id")
  visitType         CustomerVisitType     @map("visit_type")
  status            CustomerVisitStatus   @default(PLANNED)
  outcome           CustomerVisitOutcome?
  plannedAt         DateTime?             @map("planned_at")
  visitedAt         DateTime?             @map("visited_at")
  noOrderReason     String?               @map("no_order_reason") @db.VarChar(500)
  collectionAmount  Decimal?              @map("collection_amount") @db.Decimal(12, 2)
  complaintNotes    String?               @map("complaint_notes") @db.VarChar(500)
  latitude          Decimal?              @db.Decimal(10, 7)
  longitude         Decimal?              @db.Decimal(10, 7)
  geoAccuracyMeters Decimal?              @map("geo_accuracy_meters") @db.Decimal(10, 2)
  notes             String?               @db.VarChar(500)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  createdById       Int?                  @map("created_by_id")
  updatedById       Int?                  @map("updated_by_id")

  customer Customer  @relation(fields: [customerId], references: [id])
  salesRep SalesRep? @relation(fields: [salesRepId], references: [id])

  @@index([customerId])
  @@index([salesRepId])
  @@index([visitType])
  @@index([status])
  @@index([plannedAt])
  @@index([visitedAt])
  @@map("customer_visits")
}

model Attachment {
  id           Int                 @id @default(autoincrement())
  ownerType    AttachmentOwnerType @map("owner_type")
  ownerId      Int                 @map("owner_id")
  fileName     String              @map("file_name") @db.VarChar(255)
  mimeType     String              @map("mime_type") @db.VarChar(120)
  fileSize     Int                 @map("file_size")
  storagePath  String              @map("storage_path") @db.VarChar(500)
  checksum     String?             @db.VarChar(128)
  status       RecordStatus        @default(ACTIVE)
  uploadedById Int?                @map("uploaded_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  deletedAt    DateTime?           @map("deleted_at")
  deletedById  Int?                @map("deleted_by_id")

  uploadedBy User? @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([ownerType, ownerId])
  @@index([status])
  @@map("attachments")
}

model Notification {
  id          Int                @id @default(autoincrement())
  userId      Int?               @map("user_id")
  title       String             @db.VarChar(160)
  message     String             @db.VarChar(500)
  type        NotificationType   @default(INFO)
  module      String?            @db.VarChar(80)
  entityType  String?            @map("entity_type") @db.VarChar(120)
  entityId    String?            @map("entity_id") @db.VarChar(120)
  status      NotificationStatus @default(UNREAD)
  readAt      DateTime?          @map("read_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  createdById Int?               @map("created_by_id")

  user      User? @relation("NotificationUser", fields: [userId], references: [id])
  createdBy User? @relation("NotificationCreatedBy", fields: [createdById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model SystemSetting {
  id          Int                    @id @default(autoincrement())
  key         String                 @unique @db.VarChar(120)
  value       Json
  valueType   SystemSettingValueType @default(STRING) @map("value_type")
  category    String                 @db.VarChar(80)
  description String?                @db.VarChar(255)
  isSensitive Boolean                @default(false) @map("is_sensitive")
  status      RecordStatus           @default(ACTIVE)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  createdById Int?                   @map("created_by_id")
  updatedById Int?                   @map("updated_by_id")
  deletedAt   DateTime?              @map("deleted_at")
  deletedById Int?                   @map("deleted_by_id")

  @@index([category])
  @@index([status])
  @@map("system_settings")
}

model Role {
  id          Int          @id @default(autoincrement())
  code        String       @unique @db.VarChar(80)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(255)
  isSystem    Boolean      @default(false) @map("is_system")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  createdById Int?         @map("created_by_id")
  updatedById Int?         @map("updated_by_id")
  deletedAt   DateTime?    @map("deleted_at")
  deletedById Int?         @map("deleted_by_id")

  users       UserRole[]
  permissions RolePermission[]

  @@index([status])
  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(160)
  module      String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId       Int      @map("user_id")
  roleId       Int      @map("role_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById Int?     @map("assigned_by_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById Int?     @map("assigned_by_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id                Int      @id @default(autoincrement())
  actorUserId       Int?     @map("actor_user_id")
  action            String   @db.VarChar(120)
  entityType        String   @map("entity_type") @db.VarChar(120)
  entityId          String?  @map("entity_id") @db.VarChar(120)
  oldValues         Json?    @map("old_values")
  newValues         Json?    @map("new_values")
  ipAddress         String?  @map("ip_address") @db.VarChar(64)
  userAgent         String?  @map("user_agent") @db.VarChar(500)
  approvalReference String?  @map("approval_reference") @db.VarChar(120)
  createdAt         DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
